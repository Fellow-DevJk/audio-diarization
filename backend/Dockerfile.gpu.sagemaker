FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_ROOT=/app/models

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3.10-venv \
        ffmpeg \
        libsndfile1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip

RUN python3.10 -m pip install \
    torch==2.5.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu124

COPY backend/requirements-container.txt \
     /app/backend/requirements-container.txt

RUN python3.10 -m pip install \
    -r /app/backend/requirements-container.txt

COPY backend/app /app/backend/app
COPY models /app/models

RUN touch /app/backend/__init__.py

COPY backend/sagemaker-entrypoint.sh \
     /usr/local/bin/sagemaker-entrypoint

RUN chmod +x /usr/local/bin/sagemaker-entrypoint

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/sagemaker-entrypoint"]

CMD ["serve"]
