{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassAudioDiarizationRoleToSageMaker",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::134857759074:role/AudioDiarizationSageMakerExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "sagemaker.amazonaws.com"
        }
      }
    }
  ]
}
